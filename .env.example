# /api/contact needs one of the two transports below. SMTP is used whenever
# SMTP_HOST is set; otherwise the Resend API is.

# ── SMTP (a cPanel mailbox) ───────────────────────────────────────────────────
# SMTP_HOST=mail.symteratech.com
# SMTP_PORT=465
# SMTP_USER=website@symteratech.com
# SMTP_PASSWORD=
# Only if the server's certificate does not match SMTP_HOST:
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Addresses, used by both transports ────────────────────────────────────────
# Where website requests are delivered (defaults to sales@symteratech.com).
CONTACT_TO=sales@symteratech.com
# The sender: a mailbox on the server for SMTP, a verified Resend sender otherwise.
CONTACT_FROM=Symtera Website <website@symteratech.com>

# Canonical origin for sitemap.xml and robots.txt. Defaults to https://symteratech.com.
SITE_URL=https://symteratech.com
